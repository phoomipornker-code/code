flowchart TD
    A(["STANDBY"]) --> M{"STOP: toggle mode"}
    M --> A
    A --> S{"Selected FORWARD + START?"}
    S -- no --> A
    S -- yes --> B{"Bat 40..56.4V and bridge DC >= 95V?"}
    B -- fail --> ERR["ERROR"] --> A
    B -- ok --> C["AC relay ON, duty=0, FWD_SOFTSTART"]
    C --> LOOP["Read sensors"]
    LOOP --> F{"Fault? OVP/BMS/OC/ADC/AC low"}
    F -- yes --> KILL["PWM off, latch"] --> A
    F -- no --> H{"FULL HOLD?"}
    H -- yes --> R{"Vbat <= 54V and DC >= 95V?"}
    R -- yes --> RESUME["Clear FULL HOLD"] --> LOOP
    R -- no --> HOLD["Stay off"] --> LOOP
    H -- no --> PH{"Forward phase"}

    PH -- SoftStart --> SS{"Ibat >= 0.35A?"}
    SS -- yes --> CC
    SS -- no --> TO{"2s timeout?"}
    TO -- no --> RAMP["Ramp duty to ~80"] --> LOOP
    TO -- "yes + I < 0.15A" --> FAULT["No-load fault"] --> A
    TO -- "yes + has I" --> CC

    PH -- CC --> CC["CC Iref=5A + taper"]
    CC --> ENT{"Enter CV? 55.5/55.7V"}
    ENT -- no --> LOOP
    ENT -- yes --> CV

    PH -- CV --> CV["CV V->Iref->duty"]
    CV --> FULL{"Full? V>=55.9 I<=0.5A 60s"}
    FULL -- yes --> Q["FULL HOLD"] --> LOOP
    FULL -- no --> HV{"V>=56.8 for 300ms?"}
    HV -- yes --> Q
    HV -- no --> EXIT{"Exit CV to CC? V<=54.8 5s"}
    EXIT -- yes --> CC
    EXIT -- no --> LOOP

    PH -- DONE --> Q
